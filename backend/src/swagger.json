              "schema": {
                "type": "object",
                "properties": {
                  "company_name": {
                    "type": "string",
                    "example": "ROOTS DIGITAL PRESS"
                  },
                  "gstin": {
                    "type": "string",
                    "example": "33AAAAA0000A1Z5"
                  },
                  "address": {
                    "type": "string",
                    "example": "123 Main Street"
                  },
                  "city": {
                    "type": "string",
                    "example": "Chennai"
                  },
                  "state": {
                    "type": "string",
                    "example": "TAMIL NADU"
                  },
                  "state_code": {
                    "type": "string",
                    "example": "33"
                  },
                  "phone": {
                    "type": "string",
                    "example": "9876543210"
                  },
                  "email": {
                    "type": "string",
                    "example": "info@rootsdigital.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Company profile updated"
          }
        }
      },
      "put": {
        "summary": "Update Company Details",
        "tags": [
          "Company Master"
        ],
        "responses": {
          "200": {
            "description": "Company profile updated"
          }
        }
      }
    },
    "/api/customers": {
      "get": {
        "summary": "List All Customers",
        "tags": [
          "Customer Master"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search by name, phone, or email"
          },
          {
            "name": "customer_type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by NORMAL or ESTIMATE"
          }
        ],
        "responses": {
          "200": {
            "description": "List of customers"
          }
        }
      },
      "post": {
        "summary": "Create New Customer",
        "tags": [
          "Customer Master"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_name": {
                    "type": "string",
                    "example": "TECHNOVA IMAGING SYSTEM PVT LTD"
                  },
                  "customer_type": {
                    "type": "string",
                    "example": "NORMAL"
                  },
                  "phone": {
                    "type": "string",
                    "example": "9876543210"
                  },
                  "email": {
                    "type": "string",
                    "example": "billing@technova.com"
                  },
                  "address": {
                    "type": "string",
                    "example": "45 Industrial Estate"
                  },
                  "city": {
                    "type": "string",
                    "example": "Chennai"
                  },
                  "state": {
                    "type": "string",
                    "example": "TAMIL NADU"
                  },
                  "state_code": {
                    "type": "string",
                    "example": "33"
                  },
                  "gstin": {
                    "type": "string",
                    "example": "33BBBBA1111B1Z2"
                  },
                  "advance_credit": {
                    "type": "number",
                    "example": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer created successfully"
          }
        }
      }
    },
