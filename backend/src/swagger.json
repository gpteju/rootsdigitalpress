    "/api/sales-bills": {
      "get": {
        "summary": "List Sales Bills",
        "tags": [
          "Sales Billing"
        ],
        "responses": {
          "200": {
            "description": "List of sales bills"
          }
        }
      },
      "post": {
        "summary": "Create New Sales Bill",
        "tags": [
          "Sales Billing"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "bill_date": {
                    "type": "string",
                    "example": "2026-09-16"
                  },
                  "tax_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "paper_id": {
                          "type": "integer",
                          "example": 1
                        },
                        "printout_type_id": {
                          "type": "integer",
                          "example": 1
                        },
                        "quantity": {
                          "type": "number",
                          "example": 100
                        },
                        "rate_based_on": {
                          "type": "string",
                          "example": "Rates"
                        },
                        "first_copy_rate": {
                          "type": "number",
                          "example": 2.5
                        },
                        "additional_copy_rate": {
                          "type": "number",
                          "example": 2
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bill created successfully"
          }
        }
      }
    },
